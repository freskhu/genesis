# ait-crawl.env.example: configuration template for scripts/bin/ait-crawl.
#
# Copy to scripts/bin/ait-crawl.env (ignored by git) or point AIT_CRAWL_ENV at your copy.
# Format: KEY=VALUE, one per line, no shell expansion. Only AIT_CRAWL_* keys are read.
# Variables already set in the environment win over this file.
#
# Without this file only the built-in `plain` route runs (one HTTP GET, no JavaScript).

# Order of the routes tried inside one call: rungs 1 to 3 of the block ladder in
# .claude/rules/web-access-escalation.md. `plain` is built in; every other name needs a command
# below. A listed route without a command is skipped and shown as `not-configured` in the summary.
AIT_CRAWL_ROUTES=plain

# Example of a full ladder, once the commands below exist:
# AIT_CRAWL_ROUTES=plain,headless,stealth,paid1,paid2

# One absolute path per route (the key is the route name in upper case). Each command is called
# as `<command> <url>` and follows the route contract in the header of scripts/bin/ait-crawl:
# text on stdout; exit 0 read, 69 blocked, 66 empty or shell, 67 definitive, 73 transient,
# 65 refused; the final URL written to $AIT_CRAWL_FINAL_URL_FILE when known.
#
# headless: a headless browser that renders JavaScript, empty profile, no cookies. No cost.
# AIT_CRAWL_ROUTE_HEADLESS=
#
# stealth: the same browser with its anti-detection options turned on. No cost.
# AIT_CRAWL_ROUTE_STEALTH=
#
# paid1: a paid unblocking provider reached through its HTTP API. Runs only if configured.
# AIT_CRAWL_ROUTE_PAID1=
#
# paid2: a paid remote browser that solves challenges, driven over CDP. Runs only if configured.
# AIT_CRAWL_ROUTE_PAID2=

# Credentials for the paid routes. The names are up to the route command, which receives every
# AIT_CRAWL_* key in its environment. Values never go to stdout, stderr or the log.
# Keep this file at mode 600; `scripts/bin/ait-segredo` writes the values without echoing them.
# AIT_CRAWL_PAID1_TOKEN=
# AIT_CRAWL_PAID2_USER=
# AIT_CRAWL_PAID2_PASSWORD=

# Optional JSONL log, one summary line per run (no page text, no credentials).
# AIT_CRAWL_LOG=
