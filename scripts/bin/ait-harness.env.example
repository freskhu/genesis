# ait-harness.env.example: configuration template for scripts/bin/ait-harness.
#
# Copy to scripts/bin/ait-harness.env (ignored by git) or point AIT_HARNESS_ENV at your copy.
# Format: KEY=VALUE, one per line, no shell expansion. Only AIT_HARNESS_* keys are read.
# Variables already set in the environment win over this file. Full list: `ait-harness --help`.

# DevTools port on the loopback interface. REQUIRED, no default: pick a free port that no other
# browser on this machine uses.
AIT_HARNESS_PORT=9250

# Profile folder. Default: $XDG_STATE_HOME/ait-harness/profile (~/.local/state when unset).
# AIT_HARNESS_PROFILE=

# Chrome or Chromium binary. Default: looked up in the usual places.
# AIT_HARNESS_CHROME=

# Space-separated ports of other browsers on this machine. The wrapper refuses to use them and
# never stops a process listening there.
# AIT_HARNESS_PROTECTED_PORTS=9230

# Command that runs a CDP script from stdin, for `run`. Optional.
# AIT_HARNESS_CLIENT=

# Watchdog: seconds without calls, and seconds since start, before Chrome is closed.
# AIT_HARNESS_IDLE_TTL=900
# AIT_HARNESS_MAX_TTL=7200

# Seconds per `run` call.
# AIT_HARNESS_CALL_TIMEOUT=300

# Regex of login-session cookie names checked at `stop` (lower case). Default: common identity
# providers.
# AIT_HARNESS_SESSION_COOKIES=

# AIT_SESSION_ID identifies the caller for the account mark and is set per session, never here.
