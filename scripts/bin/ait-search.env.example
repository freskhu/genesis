# ait-search.env.example: configuration template for scripts/bin/ait-search.
#
# Copy to scripts/bin/ait-search.env (ignored by git) or point AIT_SEARCH_ENV at your copy.
# Read only when AIT_SEARCH_URL is not set in the environment. Format: KEY=VALUE, no shell
# expansion. Full description: `ait-search --help`.

# Base URL of a metasearch service that answers `GET <base>/search?q=...&format=json`, with the
# JSON output format enabled. Required: without it the command exits 78. Usually a service you
# run yourself on this machine.
AIT_SEARCH_URL=http://localhost:8080
